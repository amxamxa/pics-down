[1476.164132, "o", "\u001b[?25l\u001b[1;1H\u001b(B\u001b[m\u001b[38;5;251;48;5;234m  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m  1 \u001b(B\u001b[m\u001b[90;48;5;234m#!/usr/bin/env bash\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                           \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                \u001b(B\u001b[m\u001b[38;5;251;48;5;234m\u001b[7m|\u001b[2;1H\u001b(B\u001b[m\u001b[38;5;251;48;5;234m  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m  2 \u001b(B\u001b[m\u001b[90;48;5;234m#\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                             \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                \u001b(B\u001b[m\u001b[38;5;251;48;5;234m\u001b[7m|\u001b[3;1H\u001b(B\u001b[m\u001b[38;5;251;48;5;234m  \u001b(B\u001b[m\u001b[38;5;242;48;5;234m  3 \u001b(B\u001b[m\u001b[90;48;5;236m# GPT: \u001b(B\u001b[m\u001b[38;5;251;48;5;234m\u001b[7mS\u001b(B\u001b[m\u001b[90;48;5;236mkript zum Herunterladen von Bildern von einer Webseite\u001b(B\u001b[m\u001b[38;5;251;48;5;236m                                                 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m\u001b[7m|\u001b[4;1H\u001b(B\u001b[m\u001b[38;5;251;48;5;234m  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m  4 \u001b(B\u001b[m\u001b[90;48;5;234m#\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                             \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                \u001b(B\u001b[m\u001b[38;5;251;48;5;234m\u001b[7m|\u001b[5;1H\u001b(B\u001b[m\u001b[38;5;251;48;5;234m  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m  5 \u001b(B\u001b[m\u001b[90;48;5;234m# Beschreibung:\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                               \u001b(B\u001b[m\u001b[38;5;251;48;5;