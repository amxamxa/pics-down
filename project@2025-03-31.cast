234m#   -h           Zeigt diese Hilfe an\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                         \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[21;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 21 \u001b(B\u001b[m\u001b[90;48;5;234m#\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                             \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[22;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 22 \u001b(B\u001b[m\u001b[90;48;5;234m# Beispiele:\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                  \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[23;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 23 \u001b(B\u001b[m\u001b[90;48;5;234m#   ./bild_downloader.sh -p 2 https://example.com/gallery/\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                    \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[24;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 24 \u001b(B\u001b[m\u001b[90;48;5;234m#   ./bild_downloader.sh -p 4 -o ~/Bilder/vacation_ https://example.com/photos\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[25;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 25 \u001b(B\u001b[m\u001b[90;48;5;234m#\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                             \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[26;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 26 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m: \u001b(B\u001b[m\u001b[38;5;148;48;5;234m<<\u001b(B\u001b[m\u001b[38;5;155;48;5;234m'MULTILINE_COMMENT'\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                       \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[27;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 27 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                              \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[28;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 28 \u001b(B\u001b[m\u001b[38;5;251;48;5;234mErklärung des Skripts:                                                        \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[29;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 29 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                              \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[30;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 30 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    Shebang-Zeile:\u001b(B\u001b[m\u001b[90;48;5;234m #!/usr/bin/env bash startet das Skript mit der Bash.\u001b(B\u001b[m\u001b[38;5;251;48;5;234m       \u001b(B\u001b[m\u001b[38;5;25"]
[540.432465, "o", "1;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[31;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 31 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    Konfigurationsbereich: Definiert Variablen für Farben, Ausgabeverzeichnis,\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234mProtokolldateiname, Präfixlänge  \u001b[32;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m    \u001b(B\u001b[m\u001b[38;5;251;48;5;234mund User-Agent.                                                               \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[33;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 32 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    Funktionen:                                                               \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[34;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 33 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        show_message\u001b(B\u001b[m\u001b[38;5;148;48;5;234m()\u001b(B\u001b[m\u001b[38;5;251;48;5;234m: Gibt eine farbige Meldung im Terminal aus.            \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[35;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 34 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        validate_url\u001b(B\u001b[m\u001b[38;5;148;48;5;234m()\u001b(B\u001b[m\u001b[38;5;251;48;5;234m: Validiert das Format der angegebenen URL.             \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[36;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 35 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        init_logging\u001b(B\u001b[m\u001b[38;5;148;48;5;234m()\u001b(B\u001b[m\u001b[38;5;251;48;5;234m: Initialisiert die Protokollierung \u001b(B\u001b[m\u001b[38;5;153;48;5;234min\u001b(B\u001b[m\u001b[38;5;251;48;5;234m eine Datei.      \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[37;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 36 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        log\u001b(B\u001b[m\u001b[38;5;148;48;5;234m()\u001b(B\u001b[m\u001b[38;5;251;48;5;234m: Schreibt eine Meldung \u001b(B\u001b[m\u001b[38;5;153;48;5;234min\u001b(B\u001b[m\u001b[38;5;251;48;5;234m die Protokolldatei und gibt sie im Ter\u001b(B\u001b[m\u001b[38;5;251;48;5;236mm\u001b(B\u001b[m\u001b[38;5;251;48;5;234minal aus.                        \u001b[38;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 37 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        show_help\u001b(B\u001b[m\u001b[38;5;148;48;5;234m()\u001b(B\u001b[m\u001b[38;5;251;48;5;234m: Zeigt die Hilfemeldung mit der Skriptverwendung und den O\u001b(B\u001b[m\u001b[38;5;251;48;5;236mp\u001b(B\u001b[m\u001b[38;5;251;48;5;234mtionen an.                       \u001b[39;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 38 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        download_images\u001b(B\u001b[m\u001b[38;5;148;48;5;234m()\u001b(B\u001b[m\u001b[38;5;251;48;5;234m: Lädt Bilder eines bestimmten Typs von der gegebenen\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234mURL herunter, benennt sie um     \u001b[40;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m    \u001b(B\u001b[m\u001b[38;5;251;48;5;234mund speichert sie im Ausgabeverzeichnis.                                      \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[41;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 39 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    Hauptprogramm:                                                            \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[42;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 40 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        Verarbeitet Befehlszeilenargumente mit \u001b(B\u001b[m\u001b[38;5;189;48;5;234mgetopts\u001b(B\u001b[m\u001b[38;5;251;48;5;234m.                       \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[43;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 41 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        Überprüft, ob eine URL angegeben wurde und validiert sie.             \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[44;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 42 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        Erstellt das Ausgabeverzeichnis, falls es nicht existiert.            \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[45;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 43 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        Ruft die Funktion download_images für jeden gewünschten Bildtyp \u001b(B\u001b[m\u001b[38;5;148;48;5;234m(\u001b(B\u001b[m\u001b[38;5;251;48;5;234mjpg, \u001b(B\u001b[m\u001b[38;5;251;48;5;236mp\u001b(B\u001b[m\u001b[38;5;251;48;5;234mng, etc.\u001b(B\u001b[m\u001b[38;5;148;48;5;234m)\u001b(B\u001b[m\u001b[38;5;251;48;5;234m auf.                   \u001b[46;1H  "]
[540.432957, "o", "\u001b(B\u001b[m\u001b[38;5;242;48;5;235m 44 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        Gibt eine Erfolgsmeldung aus und listet die heruntergeladenen Dateien \u001b(B\u001b[m\u001b[38;5;251;48;5;236ma\u001b(B\u001b[m\u001b[38;5;251;48;5;234muf.                              \u001b[47;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 45 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        Gibt den Pfad zur Protokolldatei aus, falls die Protokollierung aktivi\u001b(B\u001b[m\u001b[38;5;251;48;5;236me\u001b(B\u001b[m\u001b[38;5;251;48;5;234mrt ist.                          \u001b[48;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 46 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    Fehlerbehandlung: Das Skript behandelt Fehler wie ungültige URLs, fehlende\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234mArgumente und fehlgeschlagene    \u001b[49;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m    \u001b(B\u001b[m\u001b[38;5;251;48;5;234mDownloads.                                                                    \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[50;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 47 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    Protokollierung: Wenn die Option\u001b(B\u001b[m\u001b[38;5;153;48;5;234m -l\u001b(B\u001b[m\u001b[38;5;251;48;5;234m angegeben ist, werden detaillierte Inf\u001b(B\u001b[m\u001b[38;5;251;48;5;236mo\u001b(B\u001b[m\u001b[38;5;251;48;5;234mrmationen über den               \u001b[51;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m    \u001b(B\u001b[m\u001b[38;5;251;48;5;234mDownloadvorgang \u001b(B\u001b[m\u001b[38;5;153;48;5;234min\u001b(B\u001b[m\u001b[38;5;251;48;5;234m einer Protokolldatei gespeichert.                          \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[52;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 48 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    Flexibilität: Das Skript ist flexibel und ermöglicht die Anpassung des Aus\u001b(B\u001b[m\u001b[38;5;251;48;5;236mg\u001b(B\u001b[m\u001b[38;5;251;48;5;234mabeverzeichnisses, der           \u001b[53;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m    \u001b(B\u001b[m\u001b[38;5;251;48;5;234mPräfixlänge und anderer Parameter über Befehlszeilenoptionen.                 \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[54;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 49 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    Robustheit: Das Skript verwendet wget mit der Option\u001b(B\u001b[m\u001b[38;5;153;48;5;234m -q\u001b(B\u001b[m\u001b[38;5;251;48;5;234m für den stillen Mo\u001b(B\u001b[m\u001b[38;5;251;48;5;236md\u001b(B\u001b[m\u001b[38;5;251;48;5;234mus und behandelt Fehler beim     \u001b[55;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m    \u001b(B\u001b[m\u001b[38;5;251;48;5;234mHerunterladen von Bildern. Es verwendet \u001b(B\u001b[m\u001b[38;5;189;48;5;234msort\u001b(B\u001b[m\u001b[38;5;153;48;5;234m -u\u001b(B\u001b[m\u001b[38;5;251;48;5;234m, um doppelte URLs zu vermeiden\u001b(B\u001b[m\u001b[38;5;251;48;5;236m.\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[56;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 50 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    **Null-Byte Trennung: Das Skript verwendet \u001b(B\u001b[m\u001b[38;5;189;48;5;234mfind\u001b(B\u001b[m\u001b[38;5;251;48;5;234m ...\u001b(B\u001b[m\u001b[38;5;153;48;5;234m -print\u001b(B\u001b[m\u001b[38;5;251;48;5;234m0 und \u001b(B\u001b[m\u001b[38;5;153;48;5;234mwhile\u001b(B\u001b[m\u001b[38;5;251;48;5;234m IFS\u001b(B\u001b[m\u001b[38;5;148;48;5;234m=\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;189;48;5;234mread\u001b(B\u001b[m\u001b[38;5;153;48;5;234m -r -d\u001b(B\u001b[m\u001b[38;5;251;48;5;234m \u001b(B\u001b[m\u001b[38;5;148;48;5;234m$\u001b(B\u001b[m\u001b[38;5;155;48;5;234m'\\0'\u001b(B\u001b[m\u001b[38;5;251;48;5;234m um Dateinamen   \u001b[57;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m    \u001b(B\u001b[m\u001b[38;5;251;48;5;234mmit Leerzeichen korrekt zu verarbeiten.                                       \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[58;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 51 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                              \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[59;1H  \u001b(B\u001b[m\u001b[38;5;242;48;5;235m 52 \u001b(B\u001b[m\u001b[38;5;251;48;5;234mMULTILINE_COMMENT                                                             \u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                 \u001b[60;1H\u001b(B\u001b[m\u001b[38;5;234;48;5;251mpics-g.sh|| |ft:shell | unix | utf-8 |(3 of 257,col: 8  1%                                Alt-g: bindings, Ctrl-g:help\u001b[61;1H\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                                                                                                      \u001b[?25l"]
