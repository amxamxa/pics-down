[511.563506, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m!/usr/bin/env bash\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m GPT: Skript zum Herunterladen von Bildern von einer Webseite\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Beschreibung:\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   Lädt Bilder von einer angegebenen URL herunter und organisiert sie.\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   Führt folgende Aufgaben durch:\u001b[0m\u001b[m\r\n"]
[511.563585, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   - Überprüft, ob eine URL als Argument übergeben wurde.\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   - Lädt die Webseite herunter und extrahiert alle eindeutigen Bild-URLs.\u001b[0m\u001b[m\r\n"]
[511.563623, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   - Lädt die Bilder herunter und benennt sie fortlaufend nummeriert und mit dem Originalnamen.\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   - Räumt temporäre Dateien auf und zeigt die heruntergeladenen Dateien an.\u001b[0m\u001b[m\r\n"]
[511.563656, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Verwendung:\u001b[0m\u001b[m\r\n"]
[511.563696, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   ./bild_downloader.sh [OPTIONEN] <URL>\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[m\r\n"]
[511.563732, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Optionen:\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   -p <LÄNGE>  Anzahl der Ziffern für die fortlaufende Nummerierung (Standard: 2)\u001b[0m\u001b[m\r\n"]
[511.563767, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   -o <VERZ>    Ausgabeverzeichnis (Standard: ./pics-down/)\u001b[0m\u001b[m\r\n"]
[511.5638, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   -l           Aktiviere die Protokollierung in eine Datei (pics-down.log)\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   -h           Zeigt diese Hilfe an\u001b[0m\u001b[m\r\n"]
[511.563831, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Beispiele:\u001b[0m\u001b[m\r\n"]
[511.563862, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   ./bild_downloader.sh -p 2 https://example.com/gallery/\u001b[0m\u001b[m\r\n"]
[511.563894, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   ./bild_downloader.sh -p 4 -o ~/Bilder/vacation_ https://example.com/photos\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[m\r\n"]
[511.56531, "o", "\u001b[38;2;142;192;124m:\u001b[0m\u001b[38;2;251;241;199m \u001b[0m\u001b[38;2;142;192;124m<<\u001b[0m\u001b[38;2;251;241;199m'\u001b[0m\u001b[38;2;251;73;52mMULTILINE_COMMENT\u001b[0m\u001b[38;2;251;241;199m'\u001b[0m\u001b[m\r\n \u001b[m\r\n\u001b[38;2;184;187;38mErklärung des Skripts:\u001b[0m\u001b[m\r\n \u001b[m\r\n\u001b[38;2;184;187;38m    Shebang-Zeile: #!/usr/bin/env bash startet das Skript mit der Bash.\u001b[0m\u001b[m\r\n"]
[511.565364, "o", "\u001b[38;2;184;187;38m    Konfigurationsbereich: Definiert Variablen für Farben, Ausgabeverzeichnis, Protokolldateiname, Präfixlänge und Use\u001b[m \b\u001b[38;2;184;187;38mr-Agent.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m    Funktionen:\u001b[0m\u001b[m\r\n"]
[511.56542, "o", "\u001b[38;2;184;187;38m        show_message(): Gibt eine farbige Meldung im Terminal aus.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        validate_url(): Validiert das Format der angegebenen URL.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        init_logging(): Initialisiert die Protokollierung in eine Datei.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        log(): Schreibt eine Meldung in die Protokolldatei und gibt sie im Terminal aus.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        show_help(): Zeigt die Hilfemeldung mit der Skriptverwendung und den Optionen an.\u001b[0m\u001b[m\r\n"]
[511.56567, "o", "\u001b[38;2;184;187;38m        download_images(): Lädt Bilder eines bestimmten Typs von der gegebenen URL herunter, benennt sie um und speich\u001b[m \b\u001b[38;2;184;187;38mert sie im Ausgabeverzeichnis.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m    Hauptprogramm:\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        Verarbeitet Befehlszeilenargumente mit getopts.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        Überprüft, ob eine URL angegeben wurde und validiert sie.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        Erstellt das Ausgabeverzeichnis, falls es nicht existiert.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        Ruft die Funktion download_images für jeden gewünschten Bildtyp (jpg, png, etc.) auf.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        Gibt eine Erfolgsmeldung aus und listet die heruntergeladenen Dateien auf.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m        Gibt den Pfad zur Protokolldatei aus, falls die Protokollierung aktiviert ist.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m    Fehlerbehandlung: Das Skript behandelt Fehler wie ungültige URLs, fehlende Argumente und fehlgeschlagene Downloads\u001b[m \b\u001b[38;2;184;187;38m.\u001b[0m\u001b[m"]
[511.565886, "o", "\r\n\u001b[38;2;184;187;38m    Protokollierung: Wenn die Option -l angegeben ist, werden detaillierte Informationen über den Downloadvorgang in e\u001b[m \b\u001b[38;2;184;187;38miner Protokolldatei gespeichert.\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38m    Flexibilität: Das Skript ist flexibel und ermöglicht die Anpassung des Ausgabeverzeichnisses, der Präfixlänge und \u001b[m \b\u001b[38;2;184;187;38manderer Parameter über Befehlszeilenoptionen.\u001b[0m\u001b[m\r\n"]
[511.565933, "o", "\u001b[38;2;184;187;38m    Robustheit: Das Skript verwendet wget mit der Option -q für den stillen Modus und behandelt Fehler beim Herunterla\u001b[m \b\u001b[38;2;184;187;38mden von Bildern. Es verwendet sort -u, um doppelte URLs zu vermeiden.\u001b[0m\u001b[m"]
[511.566477, "o", "\r\n"]
[511.566541, "o", "\u001b[38;2;184;187;38m    **Null-Byte Trennung: Das Skript verwendet find ... -print0 und while IFS= read -r -d $'\\0' um Dateinamen mit Leer\u001b[m \b\u001b[38;2;184;187;38mzeichen korrekt zu verarbeiten.\u001b[0m\u001b[m\r\n \u001b[m\r\n\u001b[38;2;251;73;52mMULTILINE_COMMENT\u001b[0m\u001b[m\r\n \u001b[m\r\n\u001b[7mbyte 4750\u001b[27m\u001b[K"]
[513.895969, "o", "\r\u001b[K"]
[513.896043, "o", "\u001b[38;2;146;131;116m\u001b[7m#\u001b[27m\u001b[38;2;146;131;116m\u001b[0m\u001b[38;2;146;131;116m\u001b[7m ==============================================\u001b[27m\u001b[38;2;146;131;116m\u001b[0m\u001b[38;2;146;131;116m\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m KONFIGURATIONSBEREICH\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m ==============================================\u001b[0m\u001b[m\r\n"]
[513.896235, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Farbdefinitionen für die Terminalausgabe\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mRESET\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38m\\e[0m\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m                  \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Setzt alle Formatierungen zurück\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mVIOLET\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38m\\033[38;2;255;0;53m\\033[48;2;34;0;82m\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m   \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Für Prompts\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mGREEN\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38m\\033[38;2;0;255;0m\\033[48;2;0;25;2m\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m      \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Erfolgsmeldungen\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mRED\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38m\\033[38;2;240;138;100m\\033[48;2;147;18;61m\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Fehlermeldungen\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mBLUE\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38m\\033[38;2;100;149;237m\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m                    \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Informationstext\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mPURPLE\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38m\\033[38;2;85;85;255m\\033[48;2;21;16;46m\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Benutzerinteraktionen\u001b[0m\u001b[m\r\n \u001b[m\r\n\u001b[38;2;131;165;152mOUT_DIR\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38m./pics-down/\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m         \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Standard-Ausgabeverzeichnis (aktuelles Verzeichnis)\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mLOG_FILE\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38mpics-down.log\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;1"]
[513.896459, "o", "99m        \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Name der Protokolldatei\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mPREFIX_LEN\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;184;187;38m2\u001b[0m\u001b[38;2;251;241;199m                    \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Anzahl der Ziffern für die fortlaufende Nummerierung (01, 02 usw.)\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mUSER_AGENT\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;184;187;38mMozilla/5.0\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m       \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Standard-User-Agent für wget\u001b[0m\u001b[m\r\n\u001b[38;2;131;165;152mLOGGING\u001b[0m\u001b[38;2;142;192;124m=\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;251;241;199m \u001b[0m\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m leer lassen, wird später gesetzt\u001b[0m\u001b[m\r\n \u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m ==============================================\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m FUNKTIONSDEFINITIONEN\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m ==============================================\u001b[0m\u001b[m\r\n \u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Zeigt eine farbige Meldung im Terminal an\u001b[0m\u001b[m\r\n"]
[513.896554, "o", "\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Argumente:\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   $1 - Farbcode\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m   $2 - Meldung\u001b[0m\u001b[m\r\n\u001b[38;2;184;187;38mshow_message\u001b[0m\u001b[38;2;251;241;199m(\u001b[0m\u001b[38;2;251;241;199m)\u001b[0m\u001b[38;2;251;241;199m \u001b[0m\u001b[38;2;251;241;199m{\u001b[0m\u001b[m\r\n\u001b[38;2;251;241;199m    \u001b[0m\u001b[38;2;142;192;124mecho\u001b[0m\u001b[38;2;251;241;199m \u001b[0m\u001b[38;2;251;241;199m-\u001b[0m\u001b[38;2;251;241;199me\u001b[0m\u001b[38;2;251;241;199m \u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[38;2;69;133;136m$\u001b[0m\u001b[38;2;251;241;199m{\u001b[0m\u001b[38;2;131;165;152m1\u001b[0m\u001b[38;2;251;241;199m}\u001b[0m\u001b[38;2;69;133;136m$\u001b[0m\u001b[38;2;251;241;199m{\u001b[0m\u001b[38;2;131;165;152m2\u001b[0m\u001b[38;2;251;241;199m}\u001b[0m\u001b[38;2;69;133;136m$\u001b[0m\u001b[38;2;251;241;199m{\u001b[0m\u001b[38;2;131;165;152mRESET\u001b[0m\u001b[38;2;251;241;199m}\u001b[0m\u001b[38;2;251;241;199m\"\u001b[0m\u001b[m\r\n\u001b[38;2;251;241;199m}\u001b[0m\u001b[m\r\n \u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Validiert das URL-Format\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;146;131;116m Argumente:\u001b[0m\u001b[m\r\n\u001b[38;2;146;131;116m#\u001b[0m\u001b[38;2;1"]
