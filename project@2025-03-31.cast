[566.045168, "o", "\u001b[?25l\u001b[1;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m37 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m    \u001b(B\u001b[m\u001b[38;5;189;48;5;234mecho\u001b(B\u001b[m\u001b[38;5;251;48;5;234m \u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"Usage: $0 [OPTIONS] <URL>\"\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                                          \u001b[1;85H                                  \u001b[2;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m38 \u001b[2;10H\u001b(B\u001b[m\u001b[38;5;189;48;5;234mecho\u001b[2;15H\u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"  -p LENGTH   Number of digits for numbering (default: $PREFIX_LEN)\"\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[3;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m39 \u001b[3;10H\u001b(B\u001b[m\u001b[38;5;189;48;5;234mecho\u001b[3;15H\u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"  -o DIR      Output directory (default: $OUT_DIR)\"\u001b[3;84H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[4;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m40 \u001b[4;10H\u001b(B\u001b[m\u001b[38;5;189;48;5;234mecho\u001b[4;15H\u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"  -h          Show help\"\u001b[4;84H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[5;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m41 \u001b(B\u001b[m\u001b[38;5;148;48;5;234m}\u001b[5;84H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[6;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m42 \u001b[6;84H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[7;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m43 \u001b(B\u001b[m\u001b[38;5;153;48;5;234mwhile\u001b[7;12H\u001b(B\u001b[m\u001b[38;5;189;48;5;234mgetopts\u001b[7;20H\u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"p:o:h\"\u001b[7;28H\u001b(B\u001b[m\u001b[38;5;251;48;5;234mopt\u001b(B\u001b[m\u001b[38;5;148;48;5;234m;\u001b[7;33H\u001b(B\u001b[m\u001b[38;5;153;48;5;234mdo\u001b[7;84H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[8;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m44 \u001b[8;10H\u001b(B\u001b[m\u001b[38;5;15