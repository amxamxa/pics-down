[1417.598827, "o", "\u001b[?25l\u001b[1;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m171 \u001b(B\u001b[m\u001b[38;5;251;48;5;234m        :\u001b(B\u001b[m\u001b[38;5;148;48;5;234m)\u001b(B\u001b[m\u001b[38;5;251;48;5;234m show_message \u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"$RED\"\u001b(B\u001b[m\u001b[38;5;251;48;5;234m \u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"Option -$OPTARG benötigt ein Argument.\"\u001b(B\u001b[m\u001b[38;5;148;48;5;234m;\u001b(B\u001b[m\u001b[38;5;251;48;5;234m \u001b(B\u001b[m\u001b[38;5;153;48;5;234mexit\u001b(B\u001b[m\u001b[38;5;251;48;5;234m \u001b(B\u001b[m\u001b[38;5;213;48;5;236m1\u001b(B\u001b[m\u001b[38;5;251;48;5;234m \u001b(B\u001b[m\u001b[38;5;148;48;5;234m;;\u001b(B\u001b[m\u001b[38;5;251;48;5;234m                              \u001b[2;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m172 \u001b[2;11H\u001b(B\u001b[m\u001b[38;5;153;48;5;234mesac\u001b[2;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[3;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m173 \u001b(B\u001b[m\u001b[38;5;153;48;5;234mdone\u001b[3;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[4;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m174 \u001b(B\u001b[m\u001b[38;5;189;48;5;234mshift\u001b[4;13H\u001b(B\u001b[m\u001b[38;5;148;48;5;234m$((\u001b(B\u001b[m\u001b[38;5;251;48;5;234mOPTIND-\u001b(B\u001b[m\u001b[38;5;213;48;5;234m1\u001b(B\u001b[m\u001b[38;5;148;48;5;234m))\u001b[4;27H\u001b(B\u001b[m\u001b[90;48;5;234m # Entferne die verarbeiteten Optionen von den Argumenten\u001b[4;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[5;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m175 \u001b[5;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[6;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m176 \u001b(B\u001b[m\u001b[90;48;5;234m# 2. Überprüfe, ob eine URL angegeben wurde.\u001b[6;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[7;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m177 \u001b(B\u001b[m\u001b[38;5;153;48;5;234mif\u001b[7;10H\u001b(B\u001b[m\u001b[38;5;148;48;5;234m[[\u001b(B\u001b[m\u001b[38;5;153;48;5;234m -z\u001b[7;16H\u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"$1\"\u001b[7;21H\u001b(B\u001b[m\u001b[38;5;148;48;5;234m]];\u001b[7;25H\u001b(B\u001b[m\u001b[38;5;153;48;5;234mthen\u001b[7;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[8;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m178 \u001b[8;11H\u001b(B\u001b[m\u001b[38;5;251;48;5;234mshow_message\u001b[8;24H\u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"$RED\"\u001b[8;31H\"Fehler: Bitte gib eine URL an.\"\u001b[8;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[9;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m179 \u001b[9;11H\u001b(B\u001b[m\u001b[38;5;251;48;5;234mshow_help\u001b[9;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[10;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m180 \u001b[10;11H\u001b(B\u001b[m\u001b[38;5;153;48;5;234mexit\u001b[10;16H\u001b(B\u001b[m\u001b[38;5;213;48;5;234m1\u001b[10;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[11;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m181 \u001b(B\u001b[m\u001b[38;5;153;48;5;234mfi\u001b[11;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[12;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m182 \u001b[12;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[13;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m183 \u001b(B\u001b[m\u001b[90;48;5;234m# 3. Validiere die URL.\u001b[13;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[14;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m184 \u001b(B\u001b[m\u001b[38;5;251;48;5;234mURL\u001b(B\u001b[m\u001b[38;5;148;48;5;234m=\u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"$1\"\u001b(B\u001b[m\u001b[90;48;5;234m # Speichere die URL in einer Variablen\u001b[14;85H\u001b(B\u001b[m\u001b[38;5;251;48;5;236m \u001b[15;3H\u001b(B\u001b[m\u001b[38;5;242;48;5;235m185 \u001b(B\u001b[m\u001b[38;5;251;48;5;234mvalidate_url\u001b[15;20H\u001b(B\u001b[m\u001b[38;5;155;48;5;234m\"$URL\"\u001b[15;27H\u001b(B\u001b[m\u001b[38;5;251;48;5;234m||\u001b[15;30H\u001b(B\u001b[m\u001b[38;5;153;48;5;234mexit\u001b[1