[1461.358901, "o", "\b\u001b[38;2;220;141;245mp\u001b[38;2;220;141;245mi\u001b[38;2;220;141;245mc\u001b[38;2;220;141;245ms\u001b[38;2;220;141;245m-\u001b[38;2;220;141;245mg\u001b[38;2;220;141;245m.\u001b[38;2;220;141;245ms\u001b[38;2;220;141;245mh\u001b[39m\u001b[39m \u001b[39m \u001b[39m \b\b\b"]
